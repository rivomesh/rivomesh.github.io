  "cards": [
    {
      "dot": "cyan",
      "title": "部署方式",
      "items": [
        "图示为分离部署。单机模式在同一服务进程中合并 Controller 与 Agent，任务仍运行于独立 Worker。"
      ]
    },
    {
      "dot": "emerald",
      "title": "持久化边界",
      "items": [
        "同一 Worker 内完成采集和按订阅投递。控制存储保存命令与任务归属，持久日志保存快照、变更和断点。"
      ]
    },
    {
      "dot": "violet",
      "title": "目标进度",
      "items": [
        "事务型 SQL 目标在同一事务提交业务行与目标断点。分析目标使用产品回执，消息 Broker 确认仅表示已接收投递。"
      ]
    }
  ]
