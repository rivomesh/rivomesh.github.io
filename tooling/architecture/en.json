  "cards": [
    {
      "dot": "cyan",
      "title": "Deployment",
      "items": [
        "The diagram shows separated deployment. Standalone combines the Controller and Agent in one service process and still launches separate Workers."
      ]
    },
    {
      "dot": "emerald",
      "title": "Durability",
      "items": [
        "Capture and delivery run inside the same Worker. The control store owns commands and assignments, while the journal stores snapshots, changes and positions."
      ]
    },
    {
      "dot": "violet",
      "title": "Target progress",
      "items": [
        "Transactional SQL commits rows and the target checkpoint together. Analytics use product-native receipts. A broker acknowledgement confirms publication."
      ]
    }
  ]
